{
  "$defs": {
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Target",
          "type": "string"
        },
        "port": {
          "default": "out",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Port",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "Edge",
      "type": "object"
    },
    "Graph": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "enum": [
            1
          ],
          "title": "Schema Version",
          "type": "integer"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/Node"
          },
          "maxItems": 100,
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "maxItems": 300,
          "title": "Edges",
          "type": "array"
        },
        "timeout": {
          "default": 300,
          "maximum": 3600,
          "minimum": 1,
          "title": "Timeout",
          "type": "integer"
        }
      },
      "title": "Graph",
      "type": "object"
    },
    "JsonValue": {},
    "Node": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Type",
          "type": "string"
        },
        "label": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "x": {
          "default": 0,
          "maximum": 100000.0,
          "minimum": -100000.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "default": 0,
          "maximum": 100000.0,
          "minimum": -100000.0,
          "title": "Y",
          "type": "number"
        },
        "config": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Config",
          "type": "object"
        },
        "retries": {
          "default": 0,
          "maximum": 3,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "timeout": {
          "default": 20,
          "maximum": 60.0,
          "minimum": 0.05,
          "title": "Timeout",
          "type": "number"
        }
      },
      "required": [
        "id",
        "type",
        "label"
      ],
      "title": "Node",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "description": {
      "default": "",
      "maxLength": 2000,
      "title": "Description",
      "type": "string"
    },
    "definition": {
      "$ref": "#/$defs/Graph"
    },
    "revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision"
    }
  },
  "required": [
    "name",
    "definition"
  ],
  "title": "WorkflowInput",
  "type": "object"
}
